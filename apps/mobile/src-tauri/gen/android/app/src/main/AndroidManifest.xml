<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0080 § 7: network (server, local network) and fingerprint only; no backup, no
     Google Play Services, no Firebase, no analytics. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Autofill (ADR 0080 § 6): the label and the signing certificate of the application
         whose form is filled. Applications with a launcher icon only; no permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.hirzla_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autofill (ADR 0080 § 6). The service is bound by the system only
             (BIND_AUTOFILL_SERVICE); it holds no key. The activity has no screen and is
             started only by the service's own pending intent. -->
        <service
            android:name=".HirzlaAutofillService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
        <activity
            android:name=".AutofillActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- The cores (ADR 0080 § 2, ADR 0085 step 5): sixteen slots, one vault and one
             process each, never exported. Android creates the process of a slot only when
             its service is started: a slot without vault costs nothing. -->
        <service
            android:name=".CoreService0"
            android:process=":core0"
            android:exported="false" />
        <service
            android:name=".CoreService1"
            android:process=":core1"
            android:exported="false" />
        <service
            android:name=".CoreService2"
            android:process=":core2"
            android:exported="false" />
        <service
            android:name=".CoreService3"
            android:process=":core3"
            android:exported="false" />
        <service
            android:name=".CoreService4"
            android:process=":core4"
            android:exported="false" />
        <service
            android:name=".CoreService5"
            android:process=":core5"
            android:exported="false" />
        <service
            android:name=".CoreService6"
            android:process=":core6"
            android:exported="false" />
        <service
            android:name=".CoreService7"
            android:process=":core7"
            android:exported="false" />
        <service
            android:name=".CoreService8"
            android:process=":core8"
            android:exported="false" />
        <service
            android:name=".CoreService9"
            android:process=":core9"
            android:exported="false" />
        <service
            android:name=".CoreService10"
            android:process=":core10"
            android:exported="false" />
        <service
            android:name=".CoreService11"
            android:process=":core11"
            android:exported="false" />
        <service
            android:name=".CoreService12"
            android:process=":core12"
            android:exported="false" />
        <service
            android:name=".CoreService13"
            android:process=":core13"
            android:exported="false" />
        <service
            android:name=".CoreService14"
            android:process=":core14"
            android:exported="false" />
        <service
            android:name=".CoreService15"
            android:process=":core15"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
