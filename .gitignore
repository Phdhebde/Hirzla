/target
# Any Cargo target directory, wherever a build put it (target/, target-*/).
target/
target-*/
**/node_modules
**/dist
*.hirzla
*.pem
*.key
.env
.DS_Store
# Written by tauri-build at each build of apps/desktop.
/apps/desktop/src-tauri/gen
/apps/desktop/src-tauri/permissions/autogenerated
# Same for apps/mobile; its Gradle project (gen/android) is kept, it holds the Kotlin layer.
/apps/mobile/src-tauri/gen/schemas
/apps/mobile/src-tauri/permissions/autogenerated
# Core and CLI copied next to the application for `cargo tauri build` (docs/livraison.md).
/apps/desktop/src-tauri/binaries
# Public site built by Zensical (website/).
/website/site
/website/.venv
# Python bytecode (scripts of .github/scripts).
__pycache__/
